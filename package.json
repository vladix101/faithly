{
  "name": "faithly",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@expo-google-fonts/alegreya": "^0.4.2",
    "@expo-google-fonts/alegreya-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.149.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "test": "jest && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/tests/*.test.mjs\" && node --test \"server/test/*.test.ts\"",
    "build:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-content.mjs",
    "build:apk": "node scripts/build-apk.mjs",
    "release": "node scripts/release.mjs",
    "test:unit": "jest",
    "test:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/tests/*.test.mjs\"",
    "build:calendar": "node scripts/generate-calendar.mjs 2026 2027",
    "build:web": "node scripts/build-web.mjs",
    "test:server": "node --test \"server/test/*.test.ts\"",
    "dev:worker": "wrangler dev",
    "deploy:web": "node scripts/build-web.mjs && wrangler d1 migrations apply faithly --remote && wrangler deploy",
    "vapid:keys": "node scripts/generate-vapid-keys.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/server/",
      "/web-dist/"
    ]
  }
}
