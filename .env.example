# Secrets are not read from .env: production secrets are Worker secrets (npx wrangler secret put VAPID_PRIVATE_KEY),
# local ones go to .dev.vars. This file only documents the names.
# Generate a pair with: node scripts/generate-vapid-keys.mjs
VAPID_PRIVATE_KEY=
# Optional: allow a local fake push server in tests, e.g. 127.0.0.1:8799
EXTRA_PUSH_HOSTS=
